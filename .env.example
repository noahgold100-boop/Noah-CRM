# Postgres. Added automatically when you connect Neon from Vercel → Storage.
DATABASE_URL=

# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Any random string, 32+ characters. Generate one: openssl rand -base64 48
SESSION_SECRET=

# Any random string. Vercel sends it to the scheduled jobs so nobody else can trigger them.
CRON_SECRET=

# The only Google account allowed to sign in
OWNER_EMAIL=noahgold100@gmail.com
OWNER_NAME=Noah Gold

# Your production URL, no trailing slash. Must match the Google redirect URI.
APP_URL=https://your-project.vercel.app

# Optional. Defaults to claude-sonnet-5-5.
# CLAUDE_MODEL=claude-sonnet-5-5
